package com.baicha.reader.core

import android.os.Bundle
import android.view.accessibility.AccessibilityNodeInfo

/**
 * 滚动到指定位置 —— 对应 TalkBack `FocusProcessorForLogicalNavigation.performActionScrollToPosition()`
 *
 * 【解决什么问题】
 *   列表/网格里「跳到第一项」「跳到最后一项」。
 *   遍历过去要一格一格走，1000 项就是 1000 次焦点移动。
 *
 * 【为什么不用 ACTION_SCROLL_FORWARD 循环】
 *   TalkBack 源码注释明确写了（FocusProcessorForLogicalNavigation:434）：
 *   > instead of ACTION_SCROLL_TO_POSITION because scroll to ...
 *   因为反复 scroll forward 依赖滚动量、item 高度、惯性，跳不准也不收敛。
 *   网格/列表本来就实现了 ACTION_SCROLL_TO_POSITION(16908358)，
 *   直接告诉它「我要第几行第几列」，由 App 自己一步到位。
 *
 * 【参数语义】（Android SDK）
 *   - ACTION_ARGUMENT_ROW_INT    = "android.view.accessibility.action.ARGUMENT_ROW_INT"
 *   - ACTION_ARGUMENT_COLUMN_INT = "android.view.accessibility.action.ARGUMENT_COLUMN_INT"
 *   行/列从 0 开始；只给行不给列时用 0。
 *
 * 【天坦做法】X6/z 的导航里同样是委托给可滚动容器，不自建滚动模型。
 */
object ScrollToPosition {

    /** 系统动作 ID */
    const val ACTION_SCROLL_TO_POSITION = 16908358

    /** 行参数键 —— 公开 SDK 不可见，按字面量给出 */
    const val ARGUMENT_ROW_INT = "android.view.accessibility.action.ARGUMENT_ROW_INT"

    /** 列参数键 */
    const val ARGUMENT_COLUMN_INT = "android.view.accessibility.action.ARGUMENT_COLUMN_INT"

    /**
     * 从 [start] 节点向上找一个支持 ACTION_SCROLL_TO_POSITION 的祖先。
     *
     * 【为什么要向上找】
     *   焦点通常在列表项（子节点）上，而 ACTION_SCROLL_TO_POSITION
     *   是列表容器（父节点）的能力。TalkBack 用
     *   `AccessibilityNodeInfoUtils.getSelfOrMatchingAncestor` 做这件事。
     *
     * @param maxDepth 向上搜索的最大层数，防止异常深的树拖慢主线程
     */
    fun findScrollableContainer(
        start: AccessibilityNodeInfo?,
        maxDepth: Int = MAX_ANCESTOR_DEPTH
    ): AccessibilityNodeInfo? {
        var node = start ?: return null
        var depth = 0
        while (depth < maxDepth) {
            if (supportsScrollToPosition(node)) return node
            node = node.parent ?: return null
            depth++
        }
        return null
    }

    /** 该节点是否支持滚动定位 */
    fun supportsScrollToPosition(node: AccessibilityNodeInfo?): Boolean {
        if (node == null) return false
        return try {
            node.actionList.any { it.id == ACTION_SCROLL_TO_POSITION }
        } catch (e: Throwable) {
            false
        }
    }

    /**
     * 滚动到指定行列。
     *
     * @param node   任意节点（内部会向上找可滚动容器）
     * @param row    目标行，从 0 开始
     * @param column 目标列，从 0 开始
     * @return 是否被容器接受
     */
    fun scrollTo(
        node: AccessibilityNodeInfo?,
        row: Int,
        column: Int = 0
    ): Boolean {
        val container = findScrollableContainer(node) ?: return false
        return scrollContainerTo(container, row, column)
    }

    /**
     * 跳到第一项。
     *
     * TalkBack 用 `ACTION_SCROLL_TO_POSITION(0, 0)`；
     * 若容器不支持，退回 [AccessibilityNodeInfo.ACTION_SCROLL_BACKWARD] 循环
     * 是不可行的（量不可控），所以这里只做一次能力探测，
     * 失败就交给上层决定（播报提示，而不是静默）。
     */
    fun scrollToTop(node: AccessibilityNodeInfo?): Boolean = scrollTo(node, row = 0, column = 0)

    /**
     * 跳到最后一项。
     *
     * 【难点】跳到「最后」需要知道总数，而 Android 没有提供
     * 「列表有多少项」的公开 API。
     *
     * TalkBack 的做法是传一个很大的行号（`Integer.MAX_VALUE`），
     * 由容器自己 clamp 到合法范围 —— 这也是 GridTraversalManager 的思路。
     */
    fun scrollToBottom(node: AccessibilityNodeInfo?): Boolean =
        scrollTo(node, row = Integer.MAX_VALUE, column = 0)

    /**
     * 直接对已确定的容器发动作。
     */
    fun scrollContainerTo(
        container: AccessibilityNodeInfo?,
        row: Int,
        column: Int
    ): Boolean {
        if (container == null) return false
        return try {
            val args = Bundle(2)
            args.putInt(ARGUMENT_ROW_INT, row)
            args.putInt(ARGUMENT_COLUMN_INT, column)
            container.performAction(ACTION_SCROLL_TO_POSITION, args)
        } catch (e: Throwable) {
            false
        }
    }

    /** 向上搜索的最大层数 */
    const val MAX_ANCESTOR_DEPTH = 20
}
